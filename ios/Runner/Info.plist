<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- App Transport Security -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
		</dict>
		<!-- Bundle Configuration -->
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Trenda</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>trenda_frontend</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- Storyboards -->
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- Orientations -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- Performance -->
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Required Permissions for Consumer App -->
		<key>NSCameraUsageDescription</key>
		<string>Trenda needs camera access to scan QR codes and take photos for reviews.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Trenda needs photo library access to upload profile photos and product reviews.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Trenda needs permission to save images to your photo library.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Trenda uses your location to show nearby stores and calculate delivery options.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Trenda uses the microphone for voice search.</string>
		<!-- speech_to_text (voice search) — iOS kills the app without this key. -->
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Trenda turns your voice into search words.</string>
		<!-- Google Sign-In (the customer app's only sign-in). The URL scheme is the
		     REVERSED_CLIENT_ID from GoogleService-Info.plist; without it the
		     sign-in sheet cannot return to the app and the plugin throws. -->
		<key>GIDClientID</key>
		<string>431491551192-dl1tegh18bvd4drae76t10trtom1quto.apps.googleusercontent.com</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.431491551192-dl1tegh18bvd4drae76t10trtom1quto</string>
				</array>
			</dict>
		</array>
		<!-- Push notifications (firebase_messaging). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<!-- Only standard HTTPS/TLS is used, so no export-compliance paperwork. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
	</dict>
</plist>
